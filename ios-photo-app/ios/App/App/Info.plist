	<string>CloudPhotos cần quyền truy cập Camera để chụp ảnh và quay video sao lưu lên Telegram.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>CloudPhotos cần quyền truy cập Microphone khi quay video để sao lưu lên Telegram.</string>
